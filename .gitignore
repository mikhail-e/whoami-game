# Node.js (package-lock.json is tracked: it pins the exact version of every package)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test coverage reports (npx jest --coverage)
coverage/

# Playwright reports and traces of failed browser tests
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# macOS
.DS_Store
.DS_Store?

# IDE: the shared VS Code settings are tracked (ESLint fixes on save, the ESLint
# extension recommended), everything else in .vscode/ is personal
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Temporary files
*.tmp
*.temp

# Game state backups the running server writes every 5 minutes (server.js keep-alive)
games/*.json
!games/.gitkeep

# Playwright MCP: page snapshots and screenshots from checking the app by hand
.playwright-mcp/

# This machine's Claude Code permissions (.claude/settings.json is shared with the project)
.claude/settings.local.json
